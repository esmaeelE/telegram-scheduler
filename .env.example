# Telegram API credentials from https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Telethon session name/path (created on first login)
TG_SESSION=telegram_scheduler

# Comma-separated usernames, phone numbers, or chat IDs
TG_CONTACTS=contact_username1,+1234567890

# Message text to schedule/send (or use --message-file)
TG_MESSAGE=Hello from telegram-scheduler

# ISO 8601 datetime. Naive values use TG_TIMEZONE. Omit when using --now.
TG_SEND_AT=2026-11-24T09:00

# Timezone for naive TG_SEND_AT values
TG_TIMEZONE=Asia/Tehran

# Retry count for retryable send failures
TG_RETRIES=2
